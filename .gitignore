*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.uv/
uv.lock  # uncomment if you prefer not to commit the lockfile

# -----------------------------------------------------------------------------
# LaTeX / TeX / plastex build artifacts (sources only in git)
# -----------------------------------------------------------------------------

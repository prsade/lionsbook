*.log
*.toc
*.out
*.dvi
*.ps
*.pdf
*.fls
*.fdb_latexmk
*.synctex*
*.bbl
*.blg
*.idx
*.ilg
*.ind
*.lof
*.lot

# -----------------------------------------------------------------------------
# Generated web output
#
# Normally we keep lionc/ out of git (it is large and changes often).
# However, for the hosted version we commit the *bilingual* (Polish + English
# tooltips) result of the translation step.
#
# Workflow:
#   - Run locally: `make lions`  (or `.\build.ps1`)
#   - This runs the bilingual post-processor
#   - Commit the result with:  git add -f lionc/
#   - Push
#
# The GitHub Pages workflow deliberately does NOT run `make lions` so that
# the committed bilingual version is what gets deployed.
# -----------------------------------------------------------------------------
lionc/

# -----------------------------------------------------------------------------
# Translation tooling secrets (CRITICAL - never commit real tokens)
# -----------------------------------------------------------------------------
pyt/credentials.json
pyt/token.json
pyt/*.json
pyt/token*.json

# -----------------------------------------------------------------------------
# Old / backup / experimental dumps
# -----------------------------------------------------------------------------
lioncold/
all.css.bak
*.bak

# -----------------------------------------------------------------------------
# Operating system / editor noise
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-*
.project
.pydevproject
.settings/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.tmp
*.temp
node_modules/
